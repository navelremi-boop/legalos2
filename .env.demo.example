# Instance de démonstration, distincte de celle des recettes.
# Copier vers .env.demo (ignoré par git). Ne jamais y mettre un secret réel.
# Démarrage : docker compose -f instance/docker-compose.yml -p legalos-demo --env-file .env.demo up -d
# Jeu : LEGALOS_MODE=development et DATABASE_URL ci-dessous, puis cargo xtask demo

LEGALOS_MODE=development

POSTGRES_USER=legalos
POSTGRES_PASSWORD=remplacer-mot-de-passe-fort-alphanumerique
POSTGRES_DB=legalos

DATABASE_URL=postgresql://legalos:remplacer-mot-de-passe-fort-alphanumerique@localhost:5433/legalos
API_BIND=0.0.0.0:8080
API_RUN_MIGRATIONS=true
RUST_LOG=info,legalos_api=debug

SECRETS_CHIFFREMENT_KEY=legalos_demo_chiffrement_32oct!!
JWT_KEY_ID=legalos-dev-1
JWT_ISSUER=legalos-api
JWT_AUDIENCE=legalos-powersync

CADDY_HTTP_PORT=8188
