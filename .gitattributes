# Fins de ligne LF partout (indispensable pour les fichiers utilisés dans les conteneurs Linux)
* text=auto eol=lf

# Scripts propres à Windows
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binaires
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.woff2 binary
*.pdf binary
*.zip binary
