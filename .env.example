# Copier vers .env à la racine du dépôt (jamais de secrets réels commités).
#
# S1 (instance Docker) — prérequis poste Windows :
#   - Docker Desktop (backend WSL2), `docker` dans le PATH
#   - WSL2 enregistré : si « WSL n'est pas enregistré », exécuter en admin :
#       wsl --install   puis redémarrer ; wsl --shutdown après .wslconfig
#   - Rust MSVC (build local API) : Visual Studio Build Tools + link.exe (voir BLOCAGES.md B2)
#   - Depuis instance/ : docker compose --env-file ../.env up -d --build --wait
#   - Ou : cargo xtask recette --scenario s1

# --- Postgres (données cabinet + stockage PowerSync) ---
POSTGRES_USER=legalos
POSTGRES_PASSWORD=remplacer-mot-de-passe-fort-alphanumerique
POSTGRES_DB=legalos

# --- API (local ou conteneur) ---
DATABASE_URL=postgresql://legalos:remplacer-mot-de-passe-fort-alphanumerique@localhost:5432/legalos
API_BIND=127.0.0.1:8080
API_RUN_MIGRATIONS=true
RUST_LOG=info,legalos_api=debug

# --- JWT / chiffrement serveur (phase S2) ---
JWT_SIGNING_KEY=generer-une-chaine-aleatoire-longue
SECRETS_CHIFFREMENT_KEY=generer-32-octets-en-base64

# --- Caddy (instance) ---
CADDY_HTTP_PORT=8088

# --- Ports exposés (développement local) ---
POSTGRES_PORT=5432
API_HOST_PORT=8080

# --- PowerSync (injectées dans docker-compose) ---
PS_DATA_SOURCE_URI=postgresql://powersync_replication:remplacer-mot-de-passe-fort-alphanumerique@postgres:5432/legalos
PS_STORAGE_URI=postgresql://legalos:remplacer-mot-de-passe-fort-alphanumerique@postgres:5432/powersync_storage

# --- Garage S3 local (64 caractères hex = 32 octets — exemple fictif dev uniquement) ---
GARAGE_RPC_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
GARAGE_ADMIN_TOKEN=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# --- GreenMail (tests messagerie) ---
GREENMAIL_USER=demo@cabinet.example
GREENMAIL_PASSWORD=remplacer-mot-de-passe-mail-test

# --- Simulateur plateforme agréée ---
PA_SIMULATEUR_URL=http://simulateur-pa:8090
