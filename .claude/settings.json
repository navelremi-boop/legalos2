{
  "permissions": {
    "allow": [
      "Bash(cargo *)",
      "PowerShell(cargo *)",
      "Bash(rustup show *)",
      "PowerShell(rustup show *)",
      "Bash(rustc --version *)",
      "PowerShell(rustc --version *)",
      "Bash(pnpm *)",
      "PowerShell(pnpm *)",
      "Bash(pnpm.cmd *)",
      "PowerShell(pnpm.cmd *)",
      "Bash(node *)",
      "PowerShell(node *)",
      "Bash(npx playwright *)",
      "PowerShell(npx playwright *)",
      "Bash(npx tauri *)",
      "PowerShell(npx tauri *)",
      "Bash(npx wdio *)",
      "PowerShell(npx wdio *)",
      "Bash(git status *)",
      "PowerShell(git status *)",
      "Bash(git diff *)",
      "PowerShell(git diff *)",
      "Bash(git log *)",
      "PowerShell(git log *)",
      "Bash(git show *)",
      "PowerShell(git show *)",
      "Bash(git add *)",
      "PowerShell(git add *)",
      "Bash(git commit *)",
      "PowerShell(git commit *)",
      "Bash(git fetch *)",
      "PowerShell(git fetch *)",
      "Bash(git pull *)",
      "PowerShell(git pull *)",
      "Bash(git switch *)",
      "PowerShell(git switch *)",
      "Bash(git checkout *)",
      "PowerShell(git checkout *)",
      "Bash(git branch *)",
      "PowerShell(git branch *)",
      "Bash(git rev-parse *)",
      "PowerShell(git rev-parse *)",
      "Bash(git worktree *)",
      "PowerShell(git worktree *)",
      "Bash(git stash *)",
      "PowerShell(git stash *)",
      "Bash(git push origin *)",
      "PowerShell(git push origin *)",
      "Bash(gh run *)",
      "PowerShell(gh run *)",
      "Bash(gh pr view *)",
      "PowerShell(gh pr view *)",
      "Bash(docker compose *)",
      "PowerShell(docker compose *)",
      "Bash(docker ps *)",
      "PowerShell(docker ps *)",
      "Bash(docker logs *)",
      "PowerShell(docker logs *)",
      "Bash(docker inspect *)",
      "PowerShell(docker inspect *)",
      "Bash(docker exec *)",
      "PowerShell(docker exec *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Select-String *)",
      "PowerShell(Test-Path *)",
      "PowerShell(Get-Location *)",
      "PowerShell(Set-Location *)",
      "PowerShell(Resolve-Path *)",
      "PowerShell(Measure-Object *)",
      "PowerShell(.\\scripts\\clippy.ps1 *)",
      "PowerShell(. .\\scripts\\bootstrap-path.ps1 *)",
      "Bash(curl -s http://127.0.0.1*)",
      "PowerShell(curl -s http://127.0.0.1*)",
      "Bash(curl http://127.0.0.1*)",
      "PowerShell(curl http://127.0.0.1*)",
      "PowerShell(Invoke-WebRequest http://127.0.0.1*)"
    ],
    "blockReadsOutsideWorkingDirectories": true,
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.cursor/hooks/garde-commandes.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.cursor/hooks/garde-secrets.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.cursor/hooks/apres-commande.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
